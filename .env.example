# Supabase Configuration
# If Supabase variables are omitted, Pixelverse runs in local demo mode using localStorage.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth Credentials
# Note: When using Supabase Auth, Google Client ID and Google Client Secret
# must be configured in your Supabase Dashboard under:
# Authentication -> Providers -> Google
# (Do NOT expose client secret or service role key to client-side code)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Application
NEXT_PUBLIC_SITE_URL=https://pixelverse-lilac.vercel.app

# WebRTC TURN Relay (for cross-network NAT traversal across different states / mobile ISPs)
# Pixelverse has built-in free multi-region STUN + Open Relay TURN fallback.
# For high-volume dedicated relay bandwidth, configure custom TURN credentials below:
# NEXT_PUBLIC_TURN_URL=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:443,turn:global.relay.metered.ca:443?transport=tcp,turns:global.relay.metered.ca:443?transport=tcp
# NEXT_PUBLIC_TURN_USERNAME=your-turn-username
# NEXT_PUBLIC_TURN_CREDENTIAL=your-turn-password

# Optional Metered Server REST API
# METERED_DOMAIN=your-app.metered.live
# METERED_API_KEY=your-metered-api-key

# LiveKit Cloud Configuration (High-Performance WebRTC SFU for Video & Voice Calling)
LIVEKIT_URL=wss://deep-pixelverse-3ap1vw7o.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here
NEXT_PUBLIC_LIVEKIT_URL=wss://deep-pixelverse-3ap1vw7o.livekit.cloud

# Feature flags
NEXT_PUBLIC_ENABLE_VOICE=true
NEXT_PUBLIC_ENABLE_AUDIO_FX=true

# Game catalog feeds
GAMEPIX_SID=your-gamepix-sid
NEXT_PUBLIC_GAMEPIX_SID=your-gamepix-sid
