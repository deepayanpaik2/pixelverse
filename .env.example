# Supabase Configuration
# If Supabase variables are omitted, Pixelverse runs in local demo mode using localStorage.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth Credentials
# Note: When using Supabase Auth, Google Client ID and Google Client Secret
# must be configured in your Supabase Dashboard under:
# Authentication -> Providers -> Google
# (Do NOT expose client secret or service role key to client-side code)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Application
NEXT_PUBLIC_SITE_URL=https://pixelverse-lilac.vercel.app

# LiveKit (optional WebRTC SFU relay)
NEXT_PUBLIC_LIVEKIT_WS_URL=wss://pixelverse-demo.livekit.cloud
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Feature flags
NEXT_PUBLIC_ENABLE_VOICE=true
NEXT_PUBLIC_ENABLE_AUDIO_FX=true

# Game catalog feeds
GAMEPIX_SID=your-gamepix-sid
NEXT_PUBLIC_GAMEPIX_SID=your-gamepix-sid
