# Supabase
# If Supabase variables are omitted, Pixelverse runs in local demo mode using localStorage.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LiveKit (optional WebRTC SFU relay)
NEXT_PUBLIC_LIVEKIT_WS_URL=wss://pixelverse-demo.livekit.cloud
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Application
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Feature flags
NEXT_PUBLIC_ENABLE_VOICE=true
NEXT_PUBLIC_ENABLE_AUDIO_FX=true

# Game catalog feed
GAMEMONETIZE_FEED_URL=https://rss.gamemonetize.com/rssfeed.php?format=json&category=All&type=html5&popularity=newest&company=All&amount=All
